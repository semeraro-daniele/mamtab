# Variabili dello stack (unico file: copia in .env). Lette da Docker Compose e, in sviluppo locale, dal backend.

# Porta pubblicata sull'host (ogni progetto sul Raspberry deve averne una diversa)
WEB_PORT=8082

# ENV=development in locale; in Docker il compose imposta production
ENV=development

# Database PostgreSQL (servizio "db", nessuna porta esposta sull'host)
DB_NAME=mamtab_db
DB_USER=mamtab
DB_PASSWORD=mamtab
# Solo sviluppo locale senza Docker (in Docker il compose usa host "db")
DB_HOST=localhost
